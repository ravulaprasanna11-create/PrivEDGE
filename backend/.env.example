# PRIVEDGE Phase 6 — Reasoning Model Configuration
# SIH26171: Privacy-Preserving Browser Agent
#
# INVARIANT: Never commit real API keys or sensitive credentials.
# Fill these environment variables in your local .env or system environment.

# Cloud Reasoning Provider API Key (e.g., OpenAI API Key)
MODEL_API_KEY=

# Model identifier (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# Base URL for the OpenAI-compatible reasoning endpoint (default: https://api.openai.com/v1)
MODEL_BASE_URL=https://api.openai.com/v1
